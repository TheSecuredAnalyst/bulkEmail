# App
APP_ENV=production
TIMEZONE=Africa/Lagos
LOG_PATH=logs/mailer.log

# Transport: smtp | sendgrid
MAIL_TRANSPORT=smtp

# Common mail headers
MAIL_FROM=sender@example.org
MAIL_FROM_NAME="Compliance Team"
MAIL_REPLY_TO=reply@example.org

# SMTP settings (if MAIL_TRANSPORT=smtp)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=tls            # tls | ssl
SMTP_USER=user@example.org
SMTP_PASS=change_me

# SendGrid settings (if MAIL_TRANSPORT=sendgrid)
SENDGRID_API_KEY=

# DKIM (optional)
DKIM_DOMAIN=
DKIM_SELECTOR=default
DKIM_PRIVATE_KEY_PATH=
DKIM_PASSPHRASE=

# Sending controls
RATE_LIMIT_PER_MINUTE=30
MAX_RETRIES=2
RETRY_DELAY_SECONDS=5

# Campaign
SUBJECT="Policy Notice"
TEMPLATE_PATH=templates/notice.html
RECIPIENTS_CSV=data/recipients.csv

# Unsubscribe base (for external mail; ignored if INTERNAL_DIRECTIVE=true)
UNSUB_BASE=https://example.org/unsub

# Copies (optional; comma-separated)
GLOBAL_CC=
GLOBAL_BCC=archive@example.org

# Modes
INTERNAL_DIRECTIVE=false    # true disables List-Unsubscribe header
DRY_RUN=false               # true → log only, do not send
TEST_MODE=false             # true → send only to TEST_TO
TEST_TO=tester@example.org
